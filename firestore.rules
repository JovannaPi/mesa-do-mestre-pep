rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Exige login (mesmo que anônimo, sem senha) em vez de deixar aberto pra qualquer
    // um na internet. O app faz login anônimo sozinho, sem tela nem fricção — só
    // precisa que "Anonymous" esteja ativado em Firebase Console → Authentication →
    // Sign-in method antes de publicar esta regra, senão ninguém consegue mais
    // ler/escrever (nem você, nem as jogadoras) até ativar.
    // Um documento por Mesa (campanha independente) em vez do antigo caminho fixo
    // "campaign/main" — mesma regra de autorização de antes, só o caminho mudou.
    match /mesas/{mesaId} {
      allow read, write: if request.auth != null;
    }
    match /mesas/{mesaId}/estado/live {
      allow read, write: if request.auth != null;
    }
    // Caminho antigo mantido só pra não quebrar quem ainda tiver a aba antiga aberta
    // durante a transição — pode ser removido depois que todo mundo atualizar.
    match /campaign/main {
      allow read, write: if request.auth != null;
    }
    match /campaign/live {
      allow read, write: if request.auth != null;
    }
  }
}
